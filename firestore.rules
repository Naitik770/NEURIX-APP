rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - uid: string (required, immutable)
    //   - name: string (required, max 50 chars)
    //   - age: number (optional, > 0)
    //   - height: number (optional, > 0)
    //   - weight: number (optional, > 0)
    //   - personality: string (optional, max 50 chars)
    //   - goals: list of strings (optional, max 10 items, max 50 chars per item)
    //   - xp: number (required, >= 0)
    //   - level: number (required, >= 1)
    //   - streak: number (required, >= 0)
    //   - lifeScore: number (required, 0-100)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: users/{userId}/habits
    // Document ID: habitId
    // Fields:
    //   - uid: string (required, immutable)
    //   - title: string (required, max 100 chars)
    //   - streak: number (required, >= 0)
    //   - lastCompleted: timestamp (optional)
    //   - isTimerBased: boolean (required)
    //   - durationMins: number (optional, > 0)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: users/{userId}/gameSessions
    // Document ID: sessionId
    // Fields:
    //   - uid: string (required, immutable)
    //   - gameId: string (required, max 50 chars)
    //   - category: string (required, max 50 chars)
    //   - score: number (required, >= 0)
    //   - xpEarned: number (required, >= 0)
    //   - playedAt: timestamp (required, immutable)
    //
    //
    // Collection: users/{userId}/reminders
    // Document ID: reminderId
    // Fields:
    //   - uid: string (required, immutable)
    //   - title: string (required, max 100 chars)
    //   - time: timestamp (required)
    //   - days: list of numbers (optional, 0-6)
    //   - enabled: boolean (required)
    //   - lastNotified: string (optional, yyyy-MM-dd)
    //   - createdAt: timestamp (required, immutable)
    //
    //
    // Collection: users/{userId}/prompts
    // Document ID: promptId
    // Fields:
    //   - uid: string (required, immutable)
    //   - text: string (required, max 5000 chars)
    //   - type: string (required, max 50 chars)
    //   - createdAt: timestamp (required, immutable)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "prajapatinaitik2435@gmail.com"); // Default admin (removed email_verified check for now)
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    function isDocOwner() {
      return isAuthenticated() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(field, minVal) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is number && request.resource.data[field] >= minVal);
    }

    // Domain Validators
    function isValidUser() {
      let allowedFields = ['uid', 'name', 'email', 'age', 'height', 'weight', 'personality', 'goals', 'xp', 'level', 'streak', 'lifeScore', 'avatarSeed', 'createdAt', 'updatedAt', 'role'];
      return hasRequiredFields(['uid', 'name', 'xp', 'level', 'streak', 'lifeScore', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('name', 1, 50) &&
             isValidOptionalString('email', 1, 100) &&
             isValidOptionalNumber('age', 1) &&
             isValidOptionalNumber('height', 1) &&
             isValidOptionalNumber('weight', 1) &&
             isValidOptionalString('personality', 1, 50) &&
             isValidOptionalString('avatarSeed', 1, 50) &&
             (!( 'goals' in request.resource.data ) || (request.resource.data.goals is list && request.resource.data.goals.size() <= 10)) &&
             request.resource.data.xp is number && request.resource.data.xp >= 0 &&
             request.resource.data.level is number && request.resource.data.level >= 1 &&
             request.resource.data.streak is number && request.resource.data.streak >= 0 &&
             request.resource.data.lifeScore is number && request.resource.data.lifeScore >= 0 && request.resource.data.lifeScore <= 100 &&
             request.resource.data.createdAt is timestamp &&
             (!( 'updatedAt' in request.resource.data ) || request.resource.data.updatedAt is timestamp) &&
             (!('role' in request.resource.data) || (request.resource.data.role is string && request.resource.data.role in ['admin', 'user']));
    }

    function isValidHabit() {
      let allowedFields = ['uid', 'title', 'streak', 'lastCompleted', 'isTimerBased', 'durationMins', 'icon', 'color', 'bg', 'createdAt'];
      return hasRequiredFields(['uid', 'title', 'streak', 'isTimerBased', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('title', 1, 100) &&
             request.resource.data.streak is number && request.resource.data.streak >= 0 &&
             (!( 'lastCompleted' in request.resource.data ) || request.resource.data.lastCompleted is timestamp) &&
             request.resource.data.isTimerBased is bool &&
             isValidOptionalNumber('durationMins', 1) &&
             isValidOptionalString('icon', 1, 50) &&
             isValidOptionalString('color', 1, 50) &&
             isValidOptionalString('bg', 1, 50) &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidGameSession() {
      let allowedFields = ['uid', 'gameId', 'category', 'score', 'xpEarned', 'playedAt'];
      return hasRequiredFields(['uid', 'gameId', 'category', 'score', 'xpEarned', 'playedAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('gameId', 1, 50) &&
             validStringLength('category', 1, 50) &&
             request.resource.data.score is number && request.resource.data.score >= 0 &&
             request.resource.data.xpEarned is number && request.resource.data.xpEarned >= 0 &&
             request.resource.data.playedAt is timestamp;
    }

    function isValidReminder() {
      let allowedFields = ['uid', 'title', 'time', 'days', 'enabled', 'lastNotified', 'createdAt'];
      return hasRequiredFields(['uid', 'title', 'time', 'enabled', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('title', 1, 100) &&
             request.resource.data.time is timestamp &&
             (!( 'days' in request.resource.data ) || (request.resource.data.days is list && request.resource.data.days.size() <= 7)) &&
             request.resource.data.enabled is bool &&
             isValidOptionalString('lastNotified', 10, 10) &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidPrompt() {
      let allowedFields = ['uid', 'text', 'type', 'createdAt'];
      return hasRequiredFields(['uid', 'text', 'type', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('text', 1, 5000) &&
             validStringLength('type', 1, 50) &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidChatSession() {
      let allowedFields = ['uid', 'title', 'lastMessage', 'updatedAt', 'createdAt'];
      return hasRequiredFields(['uid', 'title', 'updatedAt', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('title', 1, 200) &&
             isValidOptionalString('lastMessage', 1, 5000) &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidChatMessage() {
      let allowedFields = ['role', 'text', 'createdAt'];
      return hasRequiredFields(['role', 'text', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             request.resource.data.role in ['user', 'model'] &&
             validStringLength('text', 1, 10000) &&
             request.resource.data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser() && uidUnchanged() && 
                    (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin());
      allow update: if isOwner(userId) && isValidUser() && uidNotModified() &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();

      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHabit() && uidUnchanged();
        allow update: if isOwner(userId) && isValidHabit() && uidNotModified() &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /gameSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGameSession() && uidUnchanged();
        allow update: if isOwner(userId) && isValidGameSession() && uidNotModified() &&
                      request.resource.data.playedAt == resource.data.playedAt;
        allow delete: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReminder() && uidUnchanged();
        allow update: if isOwner(userId) && isValidReminder() && uidNotModified() &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /prompts/{promptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPrompt() && uidUnchanged();
        allow update: if isOwner(userId) && isValidPrompt() && uidNotModified() &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /chatSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatSession() && uidUnchanged();
        allow update: if isOwner(userId) && isValidChatSession() && uidNotModified() &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidChatMessage();
          allow update: if false;
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
