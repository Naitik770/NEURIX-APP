rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() < 100;
    }
    
    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt', 'status']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() < 5000 &&
             data.status in ['sent', 'delivered', 'seen'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMessage(request.resource.data);
      allow update: if isAuthenticated() && 
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) || 
                     (resource.data.senderId == request.auth.uid && isValidMessage(request.resource.data)));
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
  }
}
